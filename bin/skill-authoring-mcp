#!/usr/bin/env bash
# bin/skill-authoring-mcp — MCP stdio server launcher for sac.
#
# Runs modules/root_mcp_entry.py with the venv Python. The launcher
# deliberately does NOT put $TOOLS_DIR/modules on PYTHONPATH: that would
# make `import mcp` resolve to the feature dir (modules/mcp) instead of
# the installed mcp library. root_mcp_entry.py imports mcp.server at its
# top, then adds modules/ to sys.path after that — the entry owns the
# ordering. Only the per-feature src/ dirs are exposed for bare sibling
# imports.
set -euo pipefail

# Point at the live main clone tools tree (bin stays committed here); the
# launcher is also installed into $HOME/.local/bin/skill-authoring-mcp with
# the same pinned path. The worktree used to author this has been retired.
TOOLS_DIR="/home/raka/.agents/skills/skill-authoring/tools"
VENV_DIR="$TOOLS_DIR/.venv"

[[ -f "$VENV_DIR/bin/activate" ]] && source "$VENV_DIR/bin/activate"

SRC_DIRS=""
for d in "$TOOLS_DIR"/modules/*/src; do
  [[ -d "$d" ]] && SRC_DIRS="$SRC_DIRS:$d"
done

export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}${SRC_DIRS:1}"

exec python3 "$TOOLS_DIR/modules/root_mcp_entry.py" "$@"
